{
    "name": "HPDialog",
    "scopeName": "source.hpdialog",
    "patterns": [
        { "include": "#section" },
        { "include": "#line" }
    ],
    "repository": {

        "section": {
            "patterns": [
                {
                    "name": "entity.name.section.hpdialog",
                    "match": "^\\[[A-Za-z0-9_]+\\]$"
                }
            ]
        },

        "line": {
            "patterns": [
                {
                    "name": "variable.other.key.hpdialog",
                    "match": "^[A-Za-z0-9_]+(?==)"
                },

                {
                    "name": "entity.name.emotion.hpdialog",
                    "match": "(?<=\\=)\\[[A-Za-z0-9_]+\\]"
                },

                {
                    "name": "string.unquoted.dialogue.hpdialog",
                    "match": "(?<=\\][^\\]]*)$|(?<=\\=\\[[A-Za-z0-9_]+\\]).+"
                }
            ]
        }
    }
}