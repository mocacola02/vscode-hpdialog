{
  "name": "HPDialog",
  "scopeName": "source.hpdialog",
  "patterns": [
    { "include": "#line" }
  ],
  "repository": {

    "line": {
      "patterns": [

        {
          "name": "comment.line.hpdialog",
          "match": "^/.*"
        },

        {
          "name": "string.key.hpdialog",
          "match": "^\\w+(?==)"
        },

        {
          "name": "keyword.operator.hpdialog",
          "match": "="
        },

        {
          "name": "keyword.control.emote.hpdialog",
          "match": "(?<=\\=)\\[[A-Za-z0-9_]*\\]"
        },

        {
          "name": "entity.name.section.hpdialog",
          "match": "^\\[[A-Za-z0-9_]*\\]"
        }

      ]
    }
  }
}