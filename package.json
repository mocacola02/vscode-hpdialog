{
    "name": "hpdialog",
    "displayName": "HPDialog",
    "description": "HP Dialog localization file highlighting",
    "version": "1.1.1",
    "license": "MIT",

    "publisher": "mocacola02",

    "engines": {
        "vscode": "^1.120.0"
    },

    "categories": [
        "Programming Languages"
    ],

    "contributes": {
        "languages": [
            {
                "id": "hpdialog",
                "aliases": [
                    "HPDialog"
                ],
                "extensions": [
                    ".int",
                    ".usa",
                    ".fra",
                    ".ger",
                    ".ita",
                    ".spa"
                ]
            }
        ],

        "grammars": [
            {
                "language": "hpdialog",
                "scopeName": "source.hpdialog",
                "path": "./syntaxes/hpdialog.tmLanguage.json"
            }
        ]
    },

    "main": "./out/extension.js",

    "files": [
        "out/**",
        "syntaxes/**",
        "language-configuration.json",
        "package.json",
        "LICENSE"
    ],

    "scripts": {
        "test": "echo \"No tests specified\" && exit 0"
    },

    "keywords": [],

    "author": "",

    "type": "commonjs",

    "repository": {
        "type": "git",
        "url": "git+https://github.com/mocacola02/vscode-hpdialog.git"
    },

    "bugs": {
        "url": "https://github.com/mocacola02/vscode-hpdialog/issues"
    },

    "homepage": "https://github.com/mocacola02/vscode-hpdialog#readme",

    "devDependencies": {
        "@types/vscode": "^1.120.0",
        "typescript": "^5.0.0"
    },

    "activationEvents": [
        "onLanguage:hpdialog"
    ]
}