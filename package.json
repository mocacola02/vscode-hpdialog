{
    "name": "hpdialog",
    "displayName": "HPDialog",
    "description": "HP Dialog localization file highlighting",
    "version": "1.0.1",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mocacola02/vscode-hpdialog.git"
    },
    "publisher": "mocacola02",
    "engines": {
        "vscode": "^1.100.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "hpdialog",
                "aliases": [
                    "HPDialog"
                ],
                "extensions": [
                    ".int",
                    ".usa",
                    ".fra",
                    ".ger",
                    ".ita",
                    ".spa"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "hpdialog",
                "scopeName": "source.hpdialog",
                "path": "./syntaxes/hpdialog.tmLanguage.json"
            }
        ],
        "themes": [
            {
                "label": "HPDialog Theme",
                "uiTheme": "vs-dark",
                "path": "./themes/hpdialog-color-theme.json"
            }
        ]
    },
    "main": "./out/extension.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "keywords": [],
    "author": "",
    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/mocacola02/vscode-hpdialog/issues"
    },
    "homepage": "https://github.com/mocacola02/vscode-hpdialog#readme",
    "devDependencies": {
        "@types/vscode": "^1.120.0",
        "typescript": "^6.0.3"
    }
}
